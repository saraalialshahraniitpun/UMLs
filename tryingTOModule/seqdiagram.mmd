sequenceDiagram
    autonumber
    actor User as user
    participant Rest as Restaurant
    participant Ord as Order
    participant State as OrderState
    participant Hist as orderHistory

    User->>Rest: viewing Menu (items, price, offers)
    User->>Ord: selectItem() & send_order()
    Ord->>Rest: receive_order()
    
    alt Order is Rejected by Restaurant
        Rest->>Ord: changeStatus() [Rejected]
        Ord->>State: setState(Rejected)
        Ord->>Hist: add_order(Order)
        Ord->>User: Notify_user() (Order Cancelled/Rejected)
    else Order is Accepted
        Rest->>Ord: confirmed_order()
        Ord->>State: setState(Confirmed)
        Ord->>Hist: add_order(Order)
        
        Note over Rest, Ord: Preparation & Delivery Flow
        Rest->>Ord: update_order_status() [Prepared]
        Ord->>State: next(Order) -> Prepared
        
        Rest->>Ord: update_order_status() [Delivered]
        Ord->>State: next(Order) -> Delivered
        
        Ord->>User: Notify_user()
    end

    User->>Hist: get_order_history()
    Hist-->>User: view_details(tracking_number)
